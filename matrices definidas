#include <iostream>
using namespace std;
int sumar(int vec1[3][3]){
    int suma=0;
    for(int i = 0; i < 3; i++) {
        for(int j = 0; j < 3; j++) {
            suma=suma+vec1[i][j];
        }
    }
    return suma;
}

int main() {
    int vec1[3][3] = {
        {1,2,3},
        {4,5,6},
        {7,8,9}
    };
    cout<< sumar(vec1);
    return 0;
}
